# Postgres
POSTGRES_USER=flight_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=flight_delay
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Airflow (uses its own metadata db inside the same postgres instance)
AIRFLOW_UID=50000

# BTS On-Time Performance months to ingest (the last month is the model's test month)
BTS_YEAR=2024
BTS_MONTHS=1,2,3,4

# Absolute path of this project on the host machine (forward slashes), e.g. C:/Users/you/Projects/flight_delay_project
HOST_PROJECT_DIR=C:/path/to/flight_delay_project
